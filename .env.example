# Секреты и настройки softradar. На сервере – /opt/softradar/.env (в git не попадает), правка:
#   ssh -t 185.198.152.76 nano /opt/softradar/.env && ssh 185.198.152.76 "cd /opt/softradar && docker compose up -d"

# Необязательно
# LOG_LEVEL=INFO
# Уведомления о сбоях деплоя и бэкапа – во ВК; без этих строк берутся из /opt/oformlyator/.env
# VK_TOKEN=
# VK_ADMIN_IDS=

# GigaChat (Сбер): ключ авторизации из личного кабинета developers.sber.ru (Basic, base64 client_id:secret)
GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS        # для юрлица – GIGACHAT_API_CORP
# GIGACHAT_MODEL=GigaChat-3-Pro
# GIGACHAT_MODEL=GigaChat-3-Ultra

# Альтернатива: OpenAI-совместимый API (cloud.ru Foundation Models). Ключ – console.cloud.ru → Foundation Models → API-ключи
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
# LLM_MODEL=GigaChat/GigaChat-4-708B-A41

# Цена за 1 млн токенов, ₽ (вход/выход) – стоимость разбора на дашборде. По умолчанию – cloud.ru GigaChat3.5-432B
# (≈ GigaChat Ultra 3.5); GigaChat-3-Pro на cloud.ru – 73.03/176.39; GigaChat-4-708B – бесплатно (0/0)
# LLM_PRICE_IN_1M=96.22
# LLM_PRICE_OUT_1M=288.6

# Мониторинг
# SOURCES=roseltorg,fabrikant
# SEARCH_QUERIES=программное обеспечение,Kaspersky,...   # через запятую
# PAGES_PER_QUERY=2
# RUN_INTERVAL_MIN=60                     # SLA заказчика – реакция на сделку до 3 часов
# MAX_ANALYZE_PER_RUN=40                  # сколько новых закупок агент разбирает за прогон
# AUTORUN=1

# Критерии и экономика
# MAX_PRICE=1000000
# MIN_MARGIN=0.08
# VENDOR_DISCOUNTS=kaspersky:0.25,drweb:0.30,...,other:0.15  # допущение скидки партнера от цены каталога

# Ежедневный Excel-отчет менеджеру на почту (пусто – не отправлять); REPORT_HOUR – час МСК
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# REPORT_TO=manager@example.com
# REPORT_HOUR=9
